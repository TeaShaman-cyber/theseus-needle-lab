{
  "$id": "https://github.com/TeaShaman-cyber/theseus-needle-lab/contracts/typed-decision/v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "decision": {
          "const": "PROBE"
        },
        "error": {
          "type": "null"
        },
        "escalation_reason": {
          "enum": [
            "CURRENTNESS_REQUIRED",
            "CONFLICTING_EVIDENCE",
            "INSUFFICIENT_EVIDENCE",
            "LEGACY_UNSPECIFIED"
          ]
        },
        "outcome": {
          "const": "DECISION"
        },
        "probe": {
          "type": "object"
        },
        "signal": {
          "type": "null"
        },
        "task": {
          "const": "EVIDENCE_ROUTING"
        }
      },
      "title": "routing probe"
    },
    {
      "properties": {
        "decision": {
          "const": "READY"
        },
        "error": {
          "type": "null"
        },
        "escalation_reason": {
          "const": "NONE"
        },
        "outcome": {
          "const": "DECISION"
        },
        "probe": {
          "type": "null"
        },
        "signal": {
          "type": "null"
        },
        "task": {
          "const": "EVIDENCE_ROUTING"
        }
      },
      "title": "routing ready"
    },
    {
      "properties": {
        "decision": {
          "const": "UNKNOWN"
        },
        "error": {
          "type": "null"
        },
        "escalation_reason": {
          "enum": [
            "CONFLICTING_EVIDENCE",
            "INSUFFICIENT_EVIDENCE",
            "NO_SAFE_PROBE",
            "LEGACY_UNSPECIFIED"
          ]
        },
        "outcome": {
          "const": "DECISION"
        },
        "probe": {
          "type": "null"
        },
        "signal": {
          "type": "null"
        },
        "task": {
          "const": "EVIDENCE_ROUTING"
        }
      },
      "title": "routing unknown"
    },
    {
      "properties": {
        "decision": {
          "type": "null"
        },
        "error": {
          "type": "null"
        },
        "escalation_reason": {
          "const": "OUT_OF_SCOPE"
        },
        "outcome": {
          "const": "NO_CALL"
        },
        "probe": {
          "type": "null"
        },
        "signal": {
          "type": "null"
        },
        "task": {
          "const": "EVIDENCE_ROUTING"
        }
      },
      "title": "routing no call"
    },
    {
      "properties": {
        "decision": {
          "type": "null"
        },
        "error": {
          "type": "null"
        },
        "escalation_reason": {
          "const": "DRIFT_SIGNAL"
        },
        "outcome": {
          "const": "SIGNAL"
        },
        "probe": {
          "type": "null"
        },
        "signal": {
          "type": "object"
        },
        "task": {
          "const": "DRIFT_SENTINEL"
        }
      },
      "title": "drift signal"
    },
    {
      "properties": {
        "decision": {
          "type": "null"
        },
        "error": {
          "type": "null"
        },
        "escalation_reason": {
          "const": "NONE"
        },
        "outcome": {
          "const": "NO_SIGNAL"
        },
        "probe": {
          "type": "null"
        },
        "signal": {
          "type": "null"
        },
        "task": {
          "const": "DRIFT_SENTINEL"
        }
      },
      "title": "drift no signal"
    },
    {
      "properties": {
        "decision": {
          "type": "null"
        },
        "error": {
          "type": "object"
        },
        "escalation_reason": {
          "const": "ERROR"
        },
        "outcome": {
          "const": "ERROR"
        },
        "probe": {
          "type": "null"
        },
        "signal": {
          "type": "null"
        }
      },
      "title": "error envelope"
    }
  ],
  "properties": {
    "advisory_confidence": {
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "calibrated": {
              "const": false
            },
            "kind": {
              "const": "UNAVAILABLE"
            },
            "value": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "calibrated": {
              "const": false
            },
            "kind": {
              "const": "MODEL_REPORTED"
            },
            "value": {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            }
          }
        },
        {
          "properties": {
            "calibrated": {
              "const": true
            },
            "kind": {
              "const": "CALIBRATED_POSTHOC"
            },
            "value": {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            }
          }
        }
      ],
      "properties": {
        "calibrated": {
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "UNAVAILABLE",
            "MODEL_REPORTED",
            "CALIBRATED_POSTHOC"
          ]
        },
        "value": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "value",
        "calibrated"
      ],
      "type": "object"
    },
    "authority_required": {
      "type": "boolean"
    },
    "currentness_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "decision": {
      "enum": [
        "PROBE",
        "READY",
        "UNKNOWN",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "code": {
              "minLength": 1,
              "type": "string"
            },
            "message": {
              "type": [
                "string",
                "null"
              ]
            },
            "phase": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "code",
            "phase",
            "message"
          ],
          "type": "object"
        }
      ]
    },
    "escalation_reason": {
      "enum": [
        "NONE",
        "CURRENTNESS_REQUIRED",
        "CONFLICTING_EVIDENCE",
        "INSUFFICIENT_EVIDENCE",
        "NO_SAFE_PROBE",
        "OUT_OF_SCOPE",
        "DRIFT_SIGNAL",
        "LEGACY_UNSPECIFIED",
        "ERROR"
      ]
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "extensions": {
      "type": "object"
    },
    "outcome": {
      "enum": [
        "DECISION",
        "NO_CALL",
        "SIGNAL",
        "NO_SIGNAL",
        "ERROR"
      ]
    },
    "probe": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "minLength": 1,
              "type": "string"
            },
            "route_target": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "route_target"
          ],
          "type": "object"
        }
      ]
    },
    "schema": {
      "const": "theseus.typed-decision.v1"
    },
    "signal": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "name": {
              "minLength": 1,
              "type": "string"
            },
            "payload": {
              "type": "object"
            }
          },
          "required": [
            "name",
            "payload"
          ],
          "type": "object"
        }
      ]
    },
    "task": {
      "enum": [
        "EVIDENCE_ROUTING",
        "DRIFT_SENTINEL"
      ]
    }
  },
  "required": [
    "schema",
    "task",
    "outcome",
    "decision",
    "probe",
    "signal",
    "error",
    "advisory_confidence",
    "evidence_refs",
    "currentness_refs",
    "escalation_reason",
    "authority_required",
    "extensions"
  ],
  "title": "Theseus Typed System-1 Decision Envelope v1",
  "type": "object"
}
