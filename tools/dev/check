#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
cd "$ROOT"
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"

printf '%s\n' '== required repository contract =='
for path in \
  README.md \
  AGENTS.md \
  docs/architecture.md \
  docs/experiment-lifecycle.md \
  docs/cookbook/README.md \
  experiments/README.md \
  receipts/README.md \
  .github/ISSUE_TEMPLATE/experiment.yml \
  config/needle-watch.json   docs/typed-decision-contract-v1.md   contracts/typed-decision/v1.schema.json   contracts/typed-decision/legacy-mapping.v1.json   contracts/typed-decision/fixtures.v1.jsonl \
  experiments/typed-decision-benchmark/v1/manifest.json \
  experiments/typed-decision-benchmark/v1/candidates.json \
  experiments/typed-decision-benchmark/v1/primary-24.jsonl \
  experiments/typed-decision-benchmark/v1/legacy-compat-24.jsonl \
  experiments/typed-decision-benchmark/v1/baseline-constant-unknown.v1.txt \
  experiments/typed-decision-benchmark/v1/README.md \
  scripts/typed_decision_benchmark.py \
  scripts/run_typed_decision_candidate.py \
  scripts/finalize_typed_decision_semif.py \
  scripts/prepare_semif_release_runtime.py \
  scripts/run_typed_decision_arm.sh \
  scripts/readback_typed_decision_benchmark.py \
  .github/workflows/typed-decision-benchmark-v1.yml; do
  if [[ ! -s "$path" ]]; then
    printf 'QA_CONTRACT_DRIFT: missing_or_empty=%s\n' "$path" >&2
    exit 2
  fi
done

printf '%s\n' '== unit and contract tests =='
python3 -m unittest discover -s tests -v

printf '%s\n' '== python syntax =='
python3 -m compileall -q needle_watch scripts tests

printf '%s\n' '== tracked JSON syntax =='
while IFS= read -r path; do
  python3 -m json.tool "$path" >/dev/null
done < <(git ls-files '*.json' | sort)

printf '%s\n' '== committed/tracked whitespace =='
python3 scripts/check_tracked_whitespace.py

printf '%s\n' '== local diff whitespace =='
git diff --check
git diff --cached --check

printf '%s\n' 'DEV_CHECK_PASS'
